{
  "name": "panda-harness",
  "private": true,
  "description": "Personal Pi harness for extension development, testing, and AI-assisted maintenance.",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "test": "vitest run",
    "test:extensions": "vitest run --project unit",
    "test:extensions:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "biome check",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json",
    "lint:typecheck": "node ./scripts/lint-typecheck.mjs"
  },
  "devDependencies": {
    "@marcfargas/pi-test-harness": "git+https://github.com/marcfargas/pi-test-harness.git#v0.6.1",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "typebox": "catalog:",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
