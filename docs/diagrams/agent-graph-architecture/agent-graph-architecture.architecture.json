  "cards": [
    {
      "dot": "cyan",
      "title": "Run lifecycle",
      "items": [
        "validateGraph, then delegation preflight (recurses subgraphs), then task creation",
        "A disallowed graph is a tool error before any task or spawn",
        "Root actor checkpoints before dispatching new admissions",
        "First infrastructure error is latched and stops dispatch",
        "Coordinators sequence subgraph, expand, fanout and feedback work; the root actor stays the sole planner and checkpoint authority"
      ]
    },
    {
      "dot": "rose",
      "title": "Decision gates",
      "items": [
        "Chain subagents.decision_gate: classifier model classifies; other chat entries run the internal agent",
        "Low confidence or exhausted chain escalates to the orchestrator",
        "Orchestrator answers with resolve_agent_graph_gate, then collects again"
      ]
    },
    {
      "dot": "amber",
      "title": "Persistence",
      "items": [
        "Snapshots in .pi/graph-runs/, written temp-file + fsync + rename",
        "Deleted when a run settles, except reload/switch/shutdown aborts",
        "Resume on session start: this session's snapshots are re-authorized before resume"
      ]
    },
    {
      "dot": "violet",
      "title": "Observability",
      "items": [
        "Run card and Herdr pane show live progress",
        "Trace is JSONL under the session task area, capped at 8 MiB",
        "/agent-graph-replay replays a trace against a candidate graph",
        "Session graph-history.json keeps per-node status, attempts and timing without outputs"
      ]
    },
    {
      "dot": "emerald",
      "title": "XState role",
      "items": [
        "XState v5 runs the root graph actor and its child actors; the graph IR stays plain data",
        "Root spawns one child per admitted node: agent or decision lifecycle, or an expand, fanout, feedback or subgraph coordinator",
        "Node children invoke fromPromise effects (spawn, gate, escalate) that call the node host",
        "Children exchange NODE.* / COORD.* request, ACK and release events with the root; ACK is sent after the root's checkpoint step",
        "Panda checkpoints persist, not XState snapshots; an opt-in inspection log records actor events",
        "Message order: agent-graph-xstate-protocol diagram"
      ]
    }
  ]
}