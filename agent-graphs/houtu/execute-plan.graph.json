{
  "name": "execute-plan",
  "inputSchema": {
    "type": "object",
    "properties": { "plan": { "type": "string" } },
    "required": ["plan"]
  },
  "nodes": {
    "parse-plan": {
      "type": "agent",
      "agent": "jintong",
      "prompt": "Parse this plan into discrete, ordered tasks with stable ids and dependencies:\n${plan}\n\nReturn the list of tasks.",
      "input": { "plan": { "path": "$.plan" } },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "goal": { "type": "string" },
                "dependsOn": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["id", "goal"]
            }
          }
        },
        "required": ["tasks"]
      }
    },
    "validate-plan": {
      "type": "agent",
      "agent": "direnjie",
      "prompt": "Validate these parsed tasks for completeness and dependency sanity:\n${tasks}\n\nReturn valid and any issues.",
      "input": { "tasks": { "node": "parse-plan", "path": "$.tasks" } },
      "outputSchema": {
        "type": "object",
        "properties": {
          "valid": { "type": "boolean" },
          "issues": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["valid"]
      }
    },
    "plan-to-graph": {
      "type": "agent",
      "agent": "juling",
      "prompt": "Convert these validated tasks into a GraphFragment that the agent_graph runtime can splice in.\n\nTasks: ${tasks}\n\nReturn { \"fragment\": { \"nodes\": { \"<taskId>\": { \"type\": \"agent\", \"agent\": \"jintong\", \"prompt\": \"<task goal>\", \"resources\": [\"workspace:main\"] } }, \"edges\": [ { \"from\": \"<dep>\", \"to\": \"<taskId>\" } ] } }. Every node must be type \"agent\" with a non-empty agent selector and prompt. Every edge from/to must reference a node id inside the fragment. To run verification after the tasks, also add an edge from each terminal task to the existing node id \"verify\".",
      "input": { "tasks": { "node": "parse-plan", "path": "$.tasks" } },
      "outputSchema": {
        "type": "object",
        "properties": { "fragment": { "type": "object" } },
        "required": ["fragment"]
      }
    },
    "expand": {
      "type": "expand",
      "source": { "node": "plan-to-graph", "path": "$.fragment" },
      "namespace": "impl"
    },
    "verify": {
      "type": "graph",
      "graph": "shared/work-verify",
      "input": { "implementation": { "path": "$.plan" } }
    },
    "result": {
      "type": "agent",
      "agent": "cangjie",
      "prompt": "Summarize the plan execution outcome. Deterministic checks passed: ${deterministicPass}. Review approved: ${reviewApproved}.",
      "input": {
        "deterministicPass": { "node": "verify", "path": "$.deterministicPass" },
        "reviewApproved": { "node": "verify", "path": "$.reviewApproved" }
      },
      "outputSchema": {
        "type": "object",
        "properties": { "summary": { "type": "string" } },
        "required": ["summary"]
      }
    }
  },
  "edges": [
    { "from": "parse-plan", "to": "validate-plan" },
    { "from": "validate-plan", "to": "plan-to-graph", "when": { "eq": [{ "node": "validate-plan", "path": "$.valid" }, true] } },
    { "from": "plan-to-graph", "to": "expand" },
    { "from": "expand", "to": "verify" },
    { "from": "verify", "to": "result" }
  ],
  "outputs": {
    "summary": { "node": "result", "path": "$.summary" }
  }
}
