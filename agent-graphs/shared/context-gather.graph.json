{
  "version": 2,
  "name": "context-gather",
  "description": "Adaptively gather caller-planned evidence with at most one gap-closing iteration.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "request": { "type": "string" },
      "tasks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "source": { "type": "string", "enum": ["project", "platform", "upstream", "work-records", "practice"] },
            "question": { "type": "string" },
            "reason": { "type": "string" }
          },
          "required": ["source", "question"]
        }
      }
    },
    "required": ["request", "tasks"]
  },
  "nodes": {
    "research": {
      "type": "bounded_feedback",
      "name": "Research",
      "maxIterations": 2,
      "maxItemsPerIteration": 200,
      "maxTotalItems": 400,
      "work": {
        "type": "fanout",
        "name": "Gather evidence",
        "items": { "path": "$.tasks" },
        "itemSchema": {
          "type": "object",
          "properties": {
            "source": { "type": "string", "enum": ["project", "platform", "upstream", "work-records", "practice"] },
            "question": { "type": "string" },
            "reason": { "type": "string" }
          },
          "required": ["source", "question"]
        },
        "dispatch": {
          "path": "$.source",
          "cases": {
            "project": "chengfeng",
            "platform": "wenchang",
            "upstream": "wenchang",
            "work-records": "wenchang",
            "practice": "wenchang"
          }
        },
        "prompt": "Request: ${request}\nTask: ${item}\n\nReturn validated JSON only: source, evidence (claim plus provenance), relevantFiles, constraints, unknowns, and conflicts. Use empty arrays when none apply.",
        "input": { "request": { "path": "$.request" } },
        "outputSchema": {
          "type": "object",
          "properties": {
            "source": { "type": "string", "enum": ["project", "platform", "upstream", "work-records", "practice"] },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "claim": { "type": "string" },
                  "provenance": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "reference": { "type": "string" },
                        "detail": { "type": "string" }
                      },
                      "required": ["reference", "detail"]
                    }
                  }
                },
                "required": ["claim", "provenance"]
              }
            },
            "relevantFiles": { "type": "array", "items": { "type": "string" } },
            "constraints": { "type": "array", "items": { "type": "string" } },
            "unknowns": { "type": "array", "items": { "type": "string" } },
            "conflicts": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["source", "evidence", "relevantFiles", "constraints", "unknowns", "conflicts"]
        }
      },
      "evaluator": {
        "type": "agent",
        "name": "Evaluate evidence",
        "agent": "direnjie",
        "prompt": "Evaluate the collected evidence against the request.\n\nRequest: ${request}\nOriginal tasks: ${tasks}\nAll accumulated iterations, all-settled results, and unresolved gaps: ${feedback}\n\nFailed or skipped evidence results are unresolved unknowns. Return only { decision: \"sufficient\" | \"continue\", gaps: [{ id, description }], tasks: [{ gapId, item: { source, question, reason } }] }. For sufficient, tasks must be empty. For continue, every task must link to a declared gap. Do not add practice research by default.",
        "retry": { "maxAttempts": 2 },
        "input": {
          "request": { "path": "$.request" },
          "tasks": { "path": "$.tasks" }
        }
      }
    },
    "synthesize": {
      "type": "agent",
      "name": "Synthesize context",
      "agent": "jintong",
      "prompt": "Synthesize GatheredContext.\n\nRequest: ${request}\nOriginal tasks: ${tasks}\nComplete terminal bounded-feedback result: ${research}\n\nTreat every failed or skipped collected result and its error as an unknown; preserve partial successful evidence. Return summary, relevantFiles, constraints, unknowns, evidence with provenance, and conflicts as validated JSON only.",
      "input": {
        "request": { "path": "$.request" },
        "tasks": { "path": "$.tasks" },
        "research": { "node": "research", "path": "$" }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "relevantFiles": { "type": "array", "items": { "type": "string" } },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "unknowns": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": { "type": "string" },
                "provenance": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "reference": { "type": "string" },
                      "detail": { "type": "string" }
                    },
                    "required": ["reference", "detail"]
                  }
                }
              },
              "required": ["claim", "provenance"]
            }
          },
          "conflicts": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["summary", "relevantFiles", "constraints", "unknowns", "evidence", "conflicts"]
      }
    }
  },
  "edges": [
    { "from": "research", "to": "synthesize" }
  ],
  "outputs": {
    "summary": { "node": "synthesize", "path": "$.summary" },
    "relevantFiles": { "node": "synthesize", "path": "$.relevantFiles" },
    "constraints": { "node": "synthesize", "path": "$.constraints" },
    "unknowns": { "node": "synthesize", "path": "$.unknowns" },
    "evidence": { "node": "synthesize", "path": "$.evidence" },
    "conflicts": { "node": "synthesize", "path": "$.conflicts" }
  }
}
