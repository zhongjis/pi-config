if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm not on PATH; run git from the direnv dev shell"
  exit 1
fi

# Typecheck is single-threaded; overlap it with the multi-core test run.
pnpm typecheck & typecheck=$!
pnpm test:extensions && pnpm exec vitest run --project integration test/integration/pi-runtime-version.integration.test.ts || { wait "$typecheck"; exit 1; }
wait "$typecheck"
