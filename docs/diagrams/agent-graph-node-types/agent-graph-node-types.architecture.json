  "cards": [
    {
      "dot": "emerald",
      "title": "agent",
      "items": [
        "prompt + input ValueRefs run one subagent",
        "outputSchema: typed JSON with in-session StructuredOutput repair; without it, raw text",
        "validation.gate: shell command in the child's cwd; non-zero exit fails the node",
        "retry.maxAttempts counts total runs",
        "Model and thinking come only from the agent's frontmatter"
      ]
    },
    {
      "dot": "rose",
      "title": "decision_gate",
      "items": [
        "state ValueRefs + bool, choice or score questions; no agent selector",
        "Output: answers.<id>.{value, confidence} + decidedBy",
        "minConfidence: node, else run setting, else 0.8",
        "Any answer below it, or an exhausted chain, escalates"
      ]
    },
    {
      "dot": "cyan",
      "title": "fanout",
      "items": [
        "items ValueRef; itemSchema checks each item",
        "dispatch.path → cases picks each item's agent",
        "Prompt receives ${item}; waits for every child",
        "results[]: index, item, status, attempt, output or error"
      ]
    },
    {
      "dot": "amber",
      "title": "bounded_feedback",
      "items": [
        "Each round: work fanout, then evaluator agent with ${feedback}",
        "Optional one-bool judge decision_gate",
        "Bounds: maxIterations, maxItemsPerIteration, maxTotalItems; optional deadline, spendLimit",
        "Stops: sufficient, no accessible route, bound reached, no progress"
      ]
    },
    {
      "dot": "violet",
      "title": "graph and expand",
      "items": [
        "graph: saved graph by name; output = its outputs; nesting depth 32",
        "expand: splices {nodes, edges, outputs?} into the live run",
        "namespace prefixes inserted ids as <namespace>:<id>",
        "A fragment must not contain fanout or bounded_feedback"
      ]
    },
    {
      "dot": "slate",
      "title": "Wiring and edges",
      "items": [
        "ValueRef {node?, path}; no node = graph input",
        "${name} resolves only from the node's own input map; unmapped = validation error",
        "when: eq/ne/gt/gte/lt/lte/exists/and/or/not; loop.maxIterations bounds a back edge",
        "OR-join: runs when forward predecessors settle; a failed node skips its dependents"
      ]
    },
    {
      "dot": "orange",
      "title": "Outcome and limits",
      "items": [
        "Reserved output $agentGraphOutcome: succeeded, partial or failed with reason",
        "Default concurrency 8",
        "500 nodes per graph or fragment; 1000 node runs"
      ]
    }
  ]
}
