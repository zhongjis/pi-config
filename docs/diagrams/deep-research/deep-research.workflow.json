  "cards": [
    {
      "dot": "emerald",
      "title": "Graph outputs",
      "items": [
        "parts, cited markdown, acceptedFindings, verifiedCoverage",
        "rejectedClaims, gaps and failures stay in the result",
        "Outcome follows coverage: succeeded, partial or failed"
      ]
    },
    {
      "dot": "orange",
      "title": "Agent routing",
      "items": [
        "Seed search and Read sources fan out one worker per task",
        "source local → chengfeng; github or web → wenchang",
        "Seed queries, Plan research, Gap-task writer: wenchang",
        "Cited report: simaqian, tool-free, ledger evidence only"
      ]
    },
    {
      "dot": "violet",
      "title": "Decision gates",
      "items": [
        "scope and judge are one-bool decision_gate nodes",
        "Low-confidence answers escalate to the orchestrator",
        "scope=false re-plans once; a second false still proceeds and the report says so"
      ]
    },
    {
      "dot": "amber",
      "title": "Research stop reasons",
      "items": [
        "sufficient: judge answers covered=true",
        "no accessible route: gap-task writer returns tasks []",
        "limits: 3 rounds, 30 tasks, USD 2 child cost, 15 min deadline",
        "no progress: no new worker output or a repeated task set"
      ]
    },
    {
      "dot": "cyan",
      "title": "Ledger and writer checks",
      "items": [
        "Claim ids r<round>-<item>-<claim>; round 0 = seed; duplicates merged",
        "Rounds ≥2 receive references already opened",
        "Writer output rejects unknown ids, unledgered URLs and secondary-only supported parts",
        "Checks prove traceability, not source truth"
      ]
    }
  ]
