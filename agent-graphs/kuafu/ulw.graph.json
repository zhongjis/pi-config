{
  "name": "ulw",
  "inputSchema": {
    "type": "object",
    "properties": {
      "request": { "type": "string" },
      "tasks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "source": { "type": "string", "enum": ["project", "platform", "upstream", "work-records", "practice"] },
            "question": { "type": "string" },
            "reason": { "type": "string" }
          },
          "required": ["source", "question"]
        }
      }
    },
    "required": ["request", "tasks"]
  },
  "nodes": {
    "context": {
      "type": "graph",
      "graph": "shared/context-gather",
      "input": {
        "request": { "path": "$.request" },
        "tasks": { "path": "$.tasks" }
      }
    },
    "classify": {
      "type": "agent",
      "agent": "jintong",
      "prompt": "Classify the work needed for the request '${request}' given this context: ${context}.\n\nReturn complexity: \"simple\" for a single bounded change, or \"complex\" for work that needs multiple coordinated agents.",
      "input": {
        "request": { "path": "$.request" },
        "context": { "node": "context", "path": "$.summary" }
      },
      "outputSchema": {
        "type": "object",
        "properties": { "complexity": { "type": "string", "enum": ["simple", "complex"] } },
        "required": ["complexity"]
      }
    },
    "direct-work": {
      "type": "agent",
      "agent": "jintong",
      "prompt": "Implement the request '${request}' as a single bounded change. Context: ${context}.",
      "input": {
        "request": { "path": "$.request" },
        "context": { "node": "context", "path": "$.summary" }
      },
      "outputSchema": {
        "type": "object",
        "properties": { "summary": { "type": "string" } },
        "required": ["summary"]
      }
    },
    "design-work-graph": {
      "type": "agent",
      "agent": "juling",
      "prompt": "Design a work graph for the complex request '${request}'. Context: ${context}.\n\nReturn { \"fragment\": { \"nodes\": { \"<id>\": { \"type\": \"agent\", \"agent\": \"jintong\", \"prompt\": \"<sub-task>\", \"resources\": [\"workspace:main\"] } }, \"edges\": [ { \"from\": \"<id>\", \"to\": \"<id>\" } ] } }. Every node must be type \"agent\" with a non-empty agent selector and prompt. Every edge from/to must reference a node id inside the fragment. Also add an edge from each terminal node to the existing node id \"verify\" so verification runs after the work.",
      "input": {
        "request": { "path": "$.request" },
        "context": { "node": "context", "path": "$.summary" }
      },
      "outputSchema": {
        "type": "object",
        "properties": { "fragment": { "type": "object" } },
        "required": ["fragment"]
      }
    },
    "expand": {
      "type": "expand",
      "source": { "node": "design-work-graph", "path": "$.fragment" },
      "namespace": "work"
    },
    "verify": {
      "type": "graph",
      "graph": "shared/work-verify",
      "input": { "implementation": { "path": "$.request" } }
    },
    "result": {
      "type": "agent",
      "agent": "cangjie",
      "prompt": "Summarize the outcome for the request '${request}'. Deterministic checks passed: ${deterministicPass}. Review approved: ${reviewApproved}.",
      "input": {
        "request": { "path": "$.request" },
        "deterministicPass": { "node": "verify", "path": "$.deterministicPass" },
        "reviewApproved": { "node": "verify", "path": "$.reviewApproved" }
      },
      "outputSchema": {
        "type": "object",
        "properties": { "summary": { "type": "string" } },
        "required": ["summary"]
      }
    }
  },
  "edges": [
    { "from": "context", "to": "classify" },
    { "from": "classify", "to": "direct-work", "when": { "eq": [{ "node": "classify", "path": "$.complexity" }, "simple"] } },
    { "from": "classify", "to": "design-work-graph", "when": { "eq": [{ "node": "classify", "path": "$.complexity" }, "complex"] } },
    { "from": "design-work-graph", "to": "expand" },
    { "from": "direct-work", "to": "verify" },
    { "from": "expand", "to": "verify" },
    { "from": "verify", "to": "result" }
  ],
  "outputs": {
    "summary": { "node": "result", "path": "$.summary" }
  }
}
